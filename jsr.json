{
  "name": "@clawstorm/cli",
  "version": "0.3.0",
  "description": "Semantic CSS Generation Engine. Transform your entire codebase into beautifully generated CSS using AI with intelligent file chunking and design system awareness.",
  "keywords": [
    "css",
    "generation",
    "ai",
    "semantic",
    "design-system",
    "cli",
    "mistral",
    "emotion",
    "stylex",
    "code-generation",
    "styling",
    "typescript",
    "node"
  ],
  "authors": [
    {
      "name": "Protongram"
    }
  ],
  "license": "MIT",
  "homepage": "https://github.com/protongramzk/clawstorm",
  "repository": {
    "type": "git",
    "url": "https://github.com/protongramzk/clawstorm"
  },
  "bugs": {
    "url": "https://github.com/protongramzk/clawstorm/issues"
  },

  "bin": {
    "clawstorm": "./src/cli.ts"
  },

  "exports": {
    "./cli": "./src/clawstorm-cli.js",
    "./cli-core": "./src/clawstorm-cli-core.js",
    "./core": "./src/clawstorm.js"
  },

  "dependencies": {
    "@ai-sdk/mistral": "^0.0.x",
    "ai": "^3.0.x",
    "chalk": "^5.3.x",
    "commander": "^11.0.x",
    "glob": "^10.3.x",
    "js-yaml": "^4.1.x",
    "ora": "^7.0.x"
  },

  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc",
    "test": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit"
  },

  "publish": {
    "include": [
      "src/**/*.ts",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "examples",
      "tests",
      ".github",
      ".git",
      ".vscode",
      "node_modules"
    ]
  }
}
